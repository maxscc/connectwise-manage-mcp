# --- ConnectWise Manage --------------------------------------------------------
# Company ID = what you type at the ConnectWise login screen
CW_MANAGE_COMPANY_ID=
# API member "mcp-readonly" (System > Members > API Members), role with Inquire only
CW_MANAGE_PUBLIC_KEY=
CW_MANAGE_PRIVATE_KEY=
# Client ID from developer.connectwise.com
CW_MANAGE_CLIENT_ID=
# Cloud NA default. Self-hosted: https://cwm.yourcompany.com
CW_MANAGE_URL=https://api-na.myconnectwise.net
# false only for a self-hosted instance with a self-signed cert
CW_MANAGE_REJECT_UNAUTHORIZED=true
# Read-only by default: create/update/delete/add-note tools are not registered.
# Set true only after widening the API member's security role.
CW_ENABLE_WRITE_TOOLS=false

# --- MCP HTTP server -------------------------------------------------------------
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8767
# Long random string; the Cloudflare MCP portal sends it as "Authorization: Bearer <token>".
# install-service.ps1 generates it on first run.
MCP_BEARER_TOKEN=
AUTH_MODE=env
MCP_OAUTH_ENABLED=false
NODE_ENV=production
